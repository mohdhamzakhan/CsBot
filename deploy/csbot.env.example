# Settings for the CsBot service. Real file: /etc/csbot.env (root-only, chmod 600).
# No spaces around "=", no quotes needed.

# Keep the app on localhost; a reverse proxy (Caddy) or an SSH tunnel is how you reach it.
CS_URL=http://127.0.0.1:5080

# Your CoinSwitch API keys.
CS_API_KEY=
CS_SECRET_KEY=

# Login password for the website. REQUIRED if you expose it to the internet. Make it long (20+ characters).
CS_APP_PASSWORD=

# Real-money orders. Leave this line commented out until you have paper-traded for weeks.
# CS_LIVE_ENABLED=1
